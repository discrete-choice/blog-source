library(rvest)
library(rmarkdown)
# 你的旧网页文件夹
old_dir <- "/Users/discrete-choice/Documents/Doc/Blog/discrete-choice.github.io/2020"
# 你要保存的新位置
new_dir <- "/Users/discrete-choice/Documents/Doc/Blog/content/post/old-posts"
# 找出所有的 html 文件
html_files <- list.files(old_dir, pattern = "\\.html$", recursive = TRUE, full.names = TRUE)
for (f in html_files) {
# 读取网页
page <- read_html(f)
# 提取标题和正文
title <- page %>% html_node(".post-title") %>% html_text(trim = TRUE)
body_html <- page %>% html_node(".post-body") %>% as.character()
# 把正文 HTML 转成干净的 Markdown
clean_md <- pandoc_convert(text = body_html, from = "html", to = "markdown")
# 拼接标准头部
final_content <- c(
"---",
paste0('title: "', title, '"'),
'date: 2020-08-01', # 如果需要精准日期，可以再修改
"---",
"",
clean_md
)
# 保存文件
writeLines(final_content, file.path(new_dir, paste0(gsub(" ", "-", title), ".md")))
}
# 1. 安装并加载 pandoc 包
if (!requireNamespace("pandoc", quietly = TRUE)) {
install.packages("pandoc")
}
library(pandoc)
library(rvest)
# 2. 设置你的旧网页文件夹和新文章保存位置
old_dir <- "/Users/discrete-choice/Documents/Doc/Blog/discrete-choice.github.io/2020"
new_dir <- "/Users/discrete-choice/Documents/Doc/Blog/content/post/old-posts"
# 3. 确保新文件夹存在
if (!dir.exists(new_dir)) {
dir.create(new_dir, recursive = TRUE)
}
# 4. 找出所有 html 文件
html_files <- list.files(old_dir, pattern = "\\.html$", recursive = TRUE, full.names = TRUE)
# 5. 循环处理每个文件
for (f in html_files) {
# 读取网页
page <- read_html(f)
# 提取标题和正文
title_node <- html_node(page, ".post-title")
# 检查标题节点是否存在，避免报错
if (is.na(title_node)) {
title <- "Untitled"
} else {
title <- html_text(title_node, trim = TRUE)
}
body_node <- html_node(page, ".post-body")
if (is.na(body_node)) {
next # 如果没有正文，跳过此文件
}
body_html <- as.character(body_node)
# 使用 pandoc 包的 pandoc_convert 函数，它支持 text 参数
clean_md <- pandoc::pandoc_convert(
text = body_html,
from = "html",
to = "markdown"
)
# 拼接标准 YAML 头部
final_content <- c(
"---",
paste0('title: "', title, '"'),
'date: 2020-08-01', # 你需要的话可以改成具体日期
"---",
"",
clean_md
)
# 保存文件，文件名使用清理过的标题
# 如果标题里包含空格，可以替换为连字符
safe_title <- gsub("[^[:alnum:] ]", "", title) # 移除特殊字符
safe_title <- gsub(" ", "-", safe_title) # 空格换连字符
file_name <- paste0(safe_title, ".md")
writeLines(final_content, file.path(new_dir, file_name), useBytes = TRUE)
message(paste("已处理:", title))
}
message("所有旧文章转换完成！")
new_dir <- "/Users/discrete-choice/Documents/Doc/Blog/content/post/old-posts"
# 设置你存放刚才生成文章的文件夹路径
new_dir <- "/Users/discrete-choice/Documents/Doc/Blog/content/post/old-posts"
# 获取里面所有的 md 文件
md_files <- list.files(new_dir, pattern = "\\.md$", full.names = TRUE)
for (f in md_files) {
# 读取文件内容
lines <- readLines(f, encoding = "UTF-8", warn = FALSE)
# 1. 删除首尾的 ::: { ... } 外壳
lines <- lines[!grepl("^:::", lines)]
# 2. 清理带大括号和复杂属性的标题，比如 "#### [](#xxx){.headerlink}[标题](链接){...} {#xxx}"
# 这步比较难用纯正则完美处理，我们用简单粗暴的方法：把所有的 {.xxx} 和 {#xxx} 删掉
lines <- gsub("\\{[^{}]+\\}", "", lines)
# 3. 把 []()[]() 这种奇怪的链接合并成普通的 [文字](链接)
# 如果链接没用，直接把纯粹的 []() 删掉
lines <- gsub("\\[\\]\\([^)]+\\)", "", lines)
# 4. 处理由于 HTML 导致的英文单词跨行断开问题（比如 Oscar\nWilde）
# 将单独的换行合并为一个空格（排除段落间的空行）
text <- paste(lines, collapse = "\n")
text <- gsub("([a-zA-Z,])\n([a-zA-Z])", "\\1 \\2", text)
# 5. 将处理后的内容写回文件
writeLines(text, f, useBytes = TRUE)
message(paste("已清理:", basename(f)))
}
